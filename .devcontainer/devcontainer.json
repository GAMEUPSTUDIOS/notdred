{
  "name": "notdred.io test server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "postCreateCommand": "npm ci && npm run build:native",
  "postStartCommand": "bash scripts/codespace-start.sh",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "notdred.io", "onAutoForward": "notify" } },
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
